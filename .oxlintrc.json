{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "no-shadow-restricted-names": "off"
  },
  "ignorePatterns": [".agents/**", ".codex/**", "lib/**", "coverage/**"],
  "env": {
    "builtin": true
  }
}
