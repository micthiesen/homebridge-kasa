{
  "name": "homebridge-kasa",
  "displayName": "Homebridge Kasa",
  "version": "9.0.2",
  "description": "Kasa smart home plugin for Homebridge. Supports devices using Legacy XOR, KLAP v2, and AES protocols.",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "tplink",
    "kasa",
    "klap",
    "homeautomation",
    "automation",
    "home",
    "smarthome",
    "smartplug",
    "smartswitch",
    "smartbulb"
  ],
  "bugs": {
    "url": "https://github.com/micthiesen/homebridge-kasa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/micthiesen/homebridge-kasa.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Michael Thiesen",
  "main": "lib/index.js",
  "files": [
    "config.schema.json",
    "lib"
  ],
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc --project tsconfig.source.json",
    "clean": "rm -rf lib/ build/",
    "clean:debug": "rm -rf $PWD/test/homebridge/persist $PWD/test/homebridge/accessories",
    "clean:debugsim": "rm -rf $PWD/test/homebridge-simulator/persist $PWD/test/homebridge-simulator/accessories",
    "debug": "pnpm run build && pnpm run debug:only",
    "debug:only": "homebridge --debug --user-storage-path $PWD/test/homebridge --plugin-path .",
    "debugsim": "pnpm run build && pnpm run debugsim:only",
    "debugsim:only": "homebridge --debug --user-storage-path $PWD/test/homebridge-simulator --plugin-path .",
    "check:write": "biome check --write .",
    "format": "biome format .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "spellcheck": "cspell '{src,test}/**/*' *.md",
    "start": "homebridge --plugin-path .",
    "pretest": "pnpm run lint && pnpm run typecheck",
    "test": "pnpm run test:only",
    "test:only": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "semver": "^7.7.4",
    "tplink-smarthome-api": "~5.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
    "@biomejs/biome": "2.4.8",
    "@micthiesen/mitools": "^2",
    "cspell": "^9.7.0",
    "fs-extra": "^11.3.4",
    "hap-nodejs": "~0.14.2",
    "homebridge": "~1.11.3",
    "ts-essentials": "^10.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.1"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": ">=18"
  }
}
