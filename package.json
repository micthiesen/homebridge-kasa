{
  "name": "homebridge-kasa",
  "displayName": "Homebridge Kasa",
  "version": "9.2.0",
  "description": "Kasa smart home plugin for Homebridge. Supports Legacy XOR, KLAP v2, AES, and TPAP protocols.",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "tplink",
    "kasa",
    "klap",
    "homeautomation",
    "automation",
    "home",
    "smarthome",
    "smartplug",
    "smartswitch",
    "smartbulb"
  ],
  "bugs": {
    "url": "https://github.com/micthiesen/homebridge-kasa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/micthiesen/homebridge-kasa.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Michael Thiesen",
  "main": "lib/index.js",
  "files": [
    "config.schema.json",
    "lib"
  ],
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc --project tsconfig.source.json",
    "clean": "rm -rf lib/",
    "check:write": "oxlint --fix --report-unused-disable-directives . && oxfmt --write .",
    "format": "oxfmt --check .",
    "lint": "oxlint --report-unused-disable-directives .",
    "typecheck": "tsc --noEmit",
    "start": "homebridge --plugin-path .",
    "pretest": "pnpm run check && pnpm run typecheck",
    "test": "pnpm run test:only",
    "test:only": "vitest run",
    "debug:script": "node --env-file=.env --import tsx/esm src/scripts/debug.ts",
    "format:write": "oxfmt --write .",
    "check": "pnpm run lint && pnpm run format"
  },
  "dependencies": {
    "@micthiesen/mitools": "^2",
    "@noble/curves": "1.9.7",
    "chalk": "^5.4.1",
    "semver": "^7.7.4",
    "tplink-smarthome-api": "~5.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
    "hap-nodejs": "~0.14.2",
    "homebridge": "~1.11.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.1",
    "oxlint": "1.80.0",
    "oxfmt": "0.65.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": ">=18"
  }
}
